#/usr/bin/bash

set -euo pipefail

OUTPUT_FILE=""
INPUT_FILES=()
OPT_LEVEL="default"
OUTPUT_TYPE="object"
BACKEND="cranelift"
VERBOSE=0
TRIPLE=""
ETREE_PIPELINE=0

log_error() {
    echo -e "\033[0;31merror:\033[0m $1" >&2
}

log_info() {
    if [ "${VERBOSE:-0}" -eq 1 ]; then
        echo -e "\033[0;32m[fear]:\033[0m $1" >&2
    fi
}

show_help() {
    cat << EOF
Usage: fear [options] files...

Options:
  -o <file>         Place the output into <file>
  -O <level>        Optimization level: [*none, default, full]
  -fetree-pipeline  Enable expression tree optimisations pipeline
  -type <type>      Output type: [*object, text, assembly, llvm-ir]
  -triple <triple>  Set target triple
  -fcranelift       Use cranelift backend (default)
  -fllvm            Use llvm backend
  -v                Enable verbose logs
  -h, --help        Display this information
EOF
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        -o)
            if [[ -z "${2:-}" ]]; then
                log_error "option '-o' requires an argument"
                exit 1
            fi
            OUTPUT_FILE="$2"
            shift 2
            ;;
        -O)
            if [[ -z "${2:-}" ]]; then
                log_error "option '-O' requires an argument"
                exit 1
            fi
            OPT_LEVEL="$2"
            shift 2
            ;;
        -type)
            if [[ -z "${2:-}" ]]; then
                log_error "option '-type' requires an argument"
                exit 1
            fi
            OUTPUT_TYPE="$2"
            shift 2
            ;;
        -triple)
            if [[ -z "${2:-}" ]]; then
                log_error "option '-triple' requires an argument"
                exit 1
            fi
            TRIPLE="$2"
            shift 2
            ;;
        -h|--help)
            show_help
            exit 0
            ;;
        -v)
            VERBOSE="1"
            shift
            ;;
        -fcranelift)
            BACKEND="cranelift"
            shift
            ;;
        -fllvm)
            BACKEND="llvm"
            shift
            ;;
        -fetree-pipeline)
            ETREE_PIPELINE=1
            shift
            ;;
        -*)
            log_error "unknown option '$1'"
            show_help
            exit 1
            ;;
        *)
            INPUT_FILES+=("$1")
            shift
            ;;
    esac
done

get_time() {
    date +%s.%N
}

format_duration() {
    local start=$1
    local end=$2
    local diff=$(awk "BEGIN {print $end - $start}")
    
    if (( $(awk "BEGIN {print ($diff < 1.0)}") )); then
        local ms=$(awk "BEGIN {print int($diff * 1000)}")
        echo "${ms}ms"
    else
        local sec=$(awk "BEGIN {printf \"%.2fs\", $diff}")
        echo "$sec"
    fi
}

if [[ ${#INPUT_FILES[@]} -eq 0 ]]; then
    log_error "no input files"
    show_help
    exit 1
fi

BUILD_DIR=$(mktemp -d -t fear-XXXXXX)

cleanup() {
    rm -rf "$BUILD_DIR"
}
trap cleanup EXIT

LINKED_IR="$BUILD_DIR/unnamed.ssa.bin"
OPT_IR="$BUILD_DIR/unnamed.opt.ssa.bin"

TOTAL_START=$(get_time)

log_info "Linking modules..."
STAGE1_START=$(get_time)

if ! fearlink -o "$LINKED_IR" "${INPUT_FILES[@]}"; then
    log_error "linking failed"
    exit 1
fi

STAGE1_END=$(get_time)
TIME_LINK=$(format_duration "$STAGE1_START" "$STAGE1_END")

log_info "Optimizing IR (level: $OPT_LEVEL)..."
STAGE2_START=$(get_time)

cp "$LINKED_IR" "$OPT_IR"
if ! fearopt -o "$OPT_IR" --opt "$OPT_LEVEL" "$LINKED_IR"; then
    log_error "optimization failed"
    exit 1
fi

STAGE2_END=$(get_time)
TIME_OPT=$(format_duration "$STAGE2_START" "$STAGE2_END")

FEARC_ARGS=(
    --backend "$BACKEND" 
    --type "$OUTPUT_TYPE" 
    --opt "$OPT_LEVEL"
)
if [ -n "$OUTPUT_FILE" ]; then
    FEARC_ARGS+=("-o" "$OUTPUT_FILE")
fi

if [ -n "$TRIPLE" ]; then
    FEARC_ARGS+=("--triple" "$TRIPLE")
fi

if [ "${VERBOSE:-0}" -eq 1 ]; then
    FEARC_ARGS+=("--multi-level")
fi

log_info "Compiling to target artifact: $OUTPUT_FILE"
STAGE3_START=$(get_time)

if ! fearc "${FEARC_ARGS[@]}" "$OPT_IR"; then
    log_error "code generation failed"
    exit 1
fi

STAGE3_END=$(get_time)
TIME_CODEGEN=$(format_duration "$STAGE3_START" "$STAGE3_END")

TOTAL_END=$(get_time)
TIME_TOTAL=$(format_duration "$TOTAL_START" "$TOTAL_END")

log_info "Build successful!"

log_info "\033[0;36m======== REPORT ========\033[0m"
log_info "    fearlink:   $TIME_LINK   "
log_info "    fearopt:    $TIME_OPT"
log_info "    fearc:      $TIME_CODEGEN"
log_info "------------------------"
log_info "    Total time: $TIME_TOTAL\n"
