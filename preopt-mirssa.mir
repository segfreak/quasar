! module "mirssa"

__abi(c) define external foo(%0: i32, %1: i32) -> i32 {
B0: (__entry__)
  %2 = const i32 $42
  %3 = const i32 $2
  %4 = mul %2, %3
  %5 = sdiv %4, %0
  %6 = sub %5, %0
  %7 = sub %6, %1
  ret i32 %7
}

__abi(c) define external fib(%0: i32) -> i32 {
B0: (__entry__)
  %1 = const i32 $1
  %2 = cmp le %0, %1
  jmpif %2 B1, B2
B2:
  %3 = sub %0, %1
  %4 = call fib(%3)
  %5 = const i32 $2
  %6 = sub %0, %5
  %7 = call fib(%6)
  %8 = add %4, %7
  ret i32 %8
B1:
  ret i32 %0
}

__abi(c) define external example1() -> i32 {
B0: (__entry__)
  %0 = const i32 $0
  %1 = const i32 $1
  %2 = cmp lt %0, %1
  jmpif %2 B1, B2
B2:
  ret i32 %0
B1:
  ret i32 %1
}

__abi(c) define external baz() -> void {
B0: (__entry__)
  %0 = alloca.i32
  %1 = alloca.i32
  %2 = const i32 $42
  %3 = const i32 $84
  store %0, %2
  store %0, %3
  ret void
}

__abi(c) define external bar(%0: i32) -> i32 {
B0: (__entry__)
  %1 = const i32 $42
  %2 = const i32 $2
  %3 = mul %1, %2
  %4 = sdiv %3, %1
  jmp B1(%4)
B1(%5: i32):
  %6 = const i32 $2
  %7 = call foo(%5, %6)
  %8 = mul %6, %7
  ret i32 %8
}

__abi(c) define external opt(%0: i32) -> i32 {
B0: (__entry__)
  %1 = const i32 $2
  %2 = mul %0, %1
  %3 = const i32 $0
  %4 = add %2, %3
  %5 = const i32 $10
  %6 = cmp gt %4, %5
  jmpif %6 B1, B2
B2:
  %10 = mul %0, %1
  ret i32 %10
B1:
  %7 = mul %0, %1
  %8 = mul %0, %1
  %9 = add %7, %8
  ret i32 %9
}

__abi(c) define external fact_tr(%0: i32, %1: i32) -> i32 {
B0: (__entry__)
  %2 = const i32 $1
  %3 = cmp le %0, %2
  jmpif %3 B1, B2
B2:
  %4 = sub %0, %2
  %5 = mul %1, %0
  %6 = call fact_tr(%4, %5)
  ret i32 %6
B1:
