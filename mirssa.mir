! module "mirssa"

__abi(c) define external fib(%0: i32) -> i32 {
B0: (__entry__)
  %1 = const i32 $1
  %2 = cmp le %0, %1
  jmpif %2 B1, B2
B2:
  %3 = sub %0, %1
  %4 = call fib(%3)
  %5 = const i32 $2
  %6 = sub %0, %5
  %7 = call fib(%6)
  %8 = add %4, %7
  ret i32 %8
B1:
  ret i32 %0
}

__abi(c) define external example1() -> i32 {
B0: (__entry__)
  %0 = const i32 $1
  jmp B1
B1:
  ret i32 %0
}

__abi(c) define external foo(%0: i32, %1: i32) -> i32 {
B0: (__entry__)
  %2 = const i32 $84
  %3 = sdiv %2, %0
  %4 = sub %3, %0
  %5 = sub %4, %1
  ret i32 %5
}

__abi(c) define external fact_tr(%0: i32, %1: i32) -> i32 {
B0: (__entry__)
  jmp B3(%0, %1)
B3(%2: i32, %3: i32):
  %4 = const i32 $1
  %5 = cmp le %2, %4
  jmpif %5 B1, B2
B2:
  %6 = sub %2, %4
  %7 = mul %3, %2
  jmp B3(%6, %7)
B1:
  ret i32 %3
}

__abi(c) define external bar(%0: i32) -> i32 {
B0: (__entry__)
  %2 = const i32 $2
  jmp B1(%2)
B1(%1: i32):
  %3 = const i32 $2
  %4 = const i32 $1
  %5 = call foo(%1, %3)
  %6 = lshl %5, %4
  ret i32 %6
}

__abi(c) define external opt(%0: i32) -> i32 {
B0: (__entry__)
  %1 = const i32 $10
  %2 = const i32 $1
  %3 = lshl %0, %2
  %4 = cmp gt %3, %1
  jmpif %4 B1, B2
B2:
  ret i32 %3
B1:
