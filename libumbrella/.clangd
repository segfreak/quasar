CompileFlags:
  Add: [
    "-std=c++26",
    "-Wall",
    "-Wextra",
    "-Wpedantic",
    "-Wshadow",
    "-Wnon-virtual-dtor",
    "-Wold-style-cast",
    "-Wno-unused-parameter"
  ]
  Compiler: clang++

Index:
  Background: Build

Diagnostics:
  UnusedIncludes: Strict
  ClangTidy:
    Add: [
      "bugprone-*",
      "performance-*",
      "readability-*"
    ]
    Remove: [
      "readability-magic-numbers",
      "readability-identifier-length",
      "modernize-*"
    ]

InlayHints:
  Enabled: Yes
  ParameterNames: Yes
  DeducedTypes: Yes
  Designators: Yes
